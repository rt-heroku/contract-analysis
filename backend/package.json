{
  "name": "document-processing-backend",
  "version": "1.0.0",
  "description": "Backend API for Document Processing Application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npx --package=typescript -- tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push --skip-generate",
    "prisma:studio": "prisma studio",
    "seed": "ts-node src/utils/seed.ts",
    "seed:once": "node dist/utils/seedOnce.js",
    "setup:demo": "prisma generate && prisma db push && npm run seed",
    "db:init": "psql $DATABASE_URL -f init-database.sql",
    "postdeploy": "npm run seed:once"
  },
  "keywords": [
    "document-processing",
    "mulesoft",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.918.0",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "ajv": "^8.17.1",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.61.2",
    "cors": "^2.8.5",
    "dagre": "^0.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "ioredis": "^5.8.2",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.0",
    "jsonpath-plus": "^10.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.22.0",
    "typescript": "^5.3.3",
    "uuid": "^13.0.0",
    "vm2": "^3.10.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
